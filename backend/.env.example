PORT=5000
MONGO_URI=mongodb://localhost:27017/your-database
JWT_SECRET=your-jwt-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Frontend URL used in password reset emails
FRONTEND_URL=http://localhost:3000

# Nodemailer SMTP settings (Gmail example below)
# For Gmail: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TradeVault <your-email@gmail.com>"

# Or use a custom SMTP host instead of SMTP_SERVICE:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
